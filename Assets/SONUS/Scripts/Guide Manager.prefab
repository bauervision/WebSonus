  m_Script: {fileID: 11500000, guid: 466c8fddddc5c414a92fe5398eea7017, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  guidePanel: {fileID: 1232904575133736682}
  guideText: {fileID: 2060502490142363658}
  nextButton: {fileID: 1479826523982811718}
  prevButton: {fileID: 3016250009376461390}
  skipButton: {fileID: 3509196966537267365}
  dontShowAgainToggle: {fileID: 4182886534294192754}
  arrowTop: {fileID: 2398171941659743141}
  arrowRight: {fileID: 2157502915316543425}
  arrowBottom: {fileID: 4330483499105375396}
  arrowLeft: {fileID: 298102737432035162}
  overlayGroup: {fileID: 0}
  steps:
  - id: 0
    text: Welcome to Sonus! Let's go over a couple things to help you explore the
      demo app.
    position: {x: 0, y: 0}
    arrow: 0
    dimBackground: 0
  - id: 1
    text: You can load preset demo missions here
    position: {x: 305, y: 182}
    arrow: 2
    dimBackground: 0
  - id: 2
    text: Once a mission has been loaded, you can set the active target to track
      here.
    position: {x: 386, y: 84}
    arrow: 2
    dimBackground: 0
  - id: 3
    text: To View the Mission in simulated AR or Sonic Tracking, jump into the scene
      with this button
    position: {x: -297, y: -290}
    arrow: 4
    dimBackground: 0
  - id: 4
    text: You can also manually add targets to the scene
    position: {x: -333, y: 69}
    arrow: 4
    dimBackground: 0
  - id: 5
    text: At any time, you can remove all targets from the scene here.
    position: {x: 330, y: -135}
    arrow: 2
    dimBackground: 0
  - id: 6
    text: The next update will include a Sonus Hunt game so you can see if tracking
      targets sonically is a viable approach or not!
    position: {x: 321, y: -330}
    arrow: 2
    dimBackground: 0
  - id: 7
    text: That's all for now, go ahead and either load a mission, or start adding
      your own targets to track with SONUS!
    position: {x: 0, y: 0}
    arrow: 0
    dimBackground: 0
  showOnStart: 1
  showOnceKey: FTUE_Main
  fadeDuration: 0.25
  debugLogs: 0
